{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    /**
     * "bundler" lets TypeScript accept .js extensions in imports and resolve
     * them to .ts files — matching what Vitest does at runtime via its
     * vite-powered resolver.
     */
    "moduleResolution": "bundler",
    /** Tests import client .tsx modules (components, BootstrapApp, runApp). */
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@loopycode/shared": ["../packages/shared/src/index.ts"]
    }
  },
  /**
   * Include package sources so relative `*.js` imports from tests resolve in
   * the IDE (TS2307) as well as under `tsc` / Vitest.
   */
  "include": [
    "**/*.ts",
    "../packages/client/src/**/*.ts",
    "../packages/client/src/**/*.tsx",
    "../packages/shared/src/**/*.ts",
    "../packages/server/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
